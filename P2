//+------------------------------------------------------------------+
//| 80 AI HYBRID VOTING ENGINE                                       |
//+------------------------------------------------------------------+
void GetAIVotes(int &buyVotes, int &sellVotes, string &sessionName)
  {
   buyVotes = 0; 
   sellVotes = 0;

   double sessionWeight = 1.0;
   bool isHighVol = false;
   GetMarketSessionDetails(sessionName, sessionWeight, isHighVol);

   // 1. Candlestick & Price Action Pattern AIs (20 AIs)
   int patternM15 = AnalyzeCandlePattern(g_tfBase);
   int patternH1  = AnalyzeCandlePattern(g_tfMid);
   
   if(patternM15 == 1)       buyVotes += 10;
   else if(patternM15 == -1) sellVotes += 10;

   if(patternH1 == 1)        buyVotes += 10;
   else if(patternH1 == -1)  sellVotes += 10;

   // 2. Multi-Timeframe Trend Reading AIs (20 AIs)
   int trendBuy = 0, trendSell = 0;
   ENUM_TIMEFRAMES tfs[4] = {PERIOD_M5, PERIOD_M15, PERIOD_H1, PERIOD_H4};
   for(int i = 0; i < 4; i++)
     {
      int handle = iMA(_Symbol, tfs[i], 20, 0, MODE_EMA, PRICE_CLOSE);
      double maVal[]; ArraySetAsSeries(maVal, true);
      if(CopyBuffer(handle, 0, 0, 1, maVal) > 0)
        {
         double price = SymbolInfoDouble(_Symbol, SYMBOL_BID);
         if(price > maVal[0])      trendBuy += 5;
         else if(price < maVal[0]) trendSell += 5;
        }
      IndicatorRelease(handle);
     }
   
   buyVotes  += trendBuy;
   sellVotes += trendSell;

   // 3. News & Fundamental Filter AIs (20 AIs)
   int newsStatus = AnalyzeNewsEvents();
   if(newsStatus == -99)
     {
      buyVotes = 0;
      sellVotes = 0;
      return;
     }
   else
     {
      if(buyVotes > sellVotes)        buyVotes += 20;
      else if(sellVotes > buyVotes)   sellVotes += 20;
      else
        {
         buyVotes  += 10;
         sellVotes += 10;
        }
     }

   // 4. Future Structure & Momentum Projection AIs (20 AIs)
   int futureM15 = AnalyzeFutureStructure(g_tfBase);
   int futureH1  = AnalyzeFutureStructure(g_tfMid);

   if(futureM15 == 1)       buyVotes += 10;
   else if(futureM15 == -1) sellVotes += 10;

   if(futureH1 == 1)        buyVotes += 10;
   else if(futureH1 == -1)  sellVotes += 10;

   // Apply Session Weighting adjustment
   buyVotes  = (int)MathRound(buyVotes * sessionWeight);
   sellVotes = (int)MathRound(sellVotes * sessionWeight);
  }

//+------------------------------------------------------------------+
//| Calculate Lot Size based on Risk % & SL                          |
//+------------------------------------------------------------------+
double CalculateRiskLot()
  {
   double freeMargin = AccountInfoDouble(ACCOUNT_MARGIN_FREE);
   double riskAmount = freeMargin * (g_riskPercent / 100.0);
   double tickValue = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   
   if(g_slPoints <= 0 || tickValue <= 0) return minLot;

   double lot = NormalizeDouble(riskAmount / (g_slPoints * tickValue), 2);
   return (lot < minLot) ? minLot : lot;
  }
 
